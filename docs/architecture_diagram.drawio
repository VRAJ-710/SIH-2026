        <mxCell id="sub_analytics" value="Analytical Profiling, Controls &amp; Guided Storytelling" style="swimlane;whiteSpace=wrap;html=1;fillColor=#0f172a;strokeColor=#059669;fontColor=#a7f3d0;fontSize=12;startSize=25;rounded=1;" vertex="1" parent="grp_frontend">
