        <mxCell id="ingest_proc" value="STANDARDIZATION &amp; QC PIPELINE&#xa;xarray + pandas + netCDF4 + pyarrow&#xa;• CF-1.8 Strict Convention Tagging&#xa;• Depth Positive-Down Convention&#xa;• Melted 8-Column Schema Transformation&#xa;• Automated Offline Fallback Caching" style="shape=process;whiteSpace=wrap;html=1;backgroundOutline=1;fillColor=#1e1b4b;strokeColor=#818cf8;fontColor=#e0e7ff;fontSize=11;fontStyle=1;" vertex="1" parent="grp_ingestion">
